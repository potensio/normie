{
  "name": "normie",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @normie/server dev & pnpm --filter @normie/web dev",
    "dev:electron": "pnpm --filter @normie/web dev & sleep 3 && pnpm --filter @normie/electron dev",
    "build": "pnpm -r build",
    "build:electron": "pnpm --filter @normie/web build && pnpm --filter @normie/electron build",
    "start:electron": "pnpm --filter @normie/electron start",
    "clean": "pnpm -r clean",
    "db:migrate": "node apps/server/src/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "author": "",
  "license": "ISC",
  "description": "Electron chat app with Claude Agent SDK and Opencode SDK support",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.7",
    "@opencode-ai/sdk": "latest",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.32.0",
    "pg": "^8.20.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.18.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.01",
    "npm-run-all": "^4.1.5",
    "wait-on": "^8.0.5"
  }
}
