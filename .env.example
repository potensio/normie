# OpenClaude Cowork Environment Configuration

# ========================================
# Database (Neon PostgreSQL)
# ========================================
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ========================================
# Auth Secrets
# ========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-key
ENCRYPTION_KEY=your-32-byte-encryption-key

# ========================================
# AI Providers (BYOK - Bring Your Own Key)
# ========================================
# All providers are enabled by default.
# Set the API keys for the providers you want to use.

# Anthropic (Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI (GPT models)
OPENAI_API_KEY=your-openai-api-key

# Google (Gemini models)
GEMINI_API_KEY=your-gemini-api-key
# or
GOOGLE_API_KEY=your-google-api-key

# Groq (fast inference)
GROQ_API_KEY=your-groq-api-key

# X.AI (Grok models)
XAI_API_KEY=your-xai-api-key

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key

# OpenRouter (multi-provider aggregator)
OPENROUTER_API_KEY=your-openrouter-api-key

# AWS Bedrock (via Mantle)
BEDROCK_API_KEY=your-bedrock-api-key
# or native AWS credentials:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

# Note: Ollama runs locally and doesn't need an API key

# ========================================
# Optional: Limit enabled providers
# ========================================
# By default, ALL providers are enabled (BYOK model)
# Uncomment to limit to specific providers:
# ENABLED_PROVIDERS=anthropic,openai,google,groq

# ========================================
# Default Provider/Model (optional)
# ========================================
# DEFAULT_PROVIDER=anthropic
# DEFAULT_MODEL=claude-opus-4-5

# ========================================
# Other Services
# ========================================
# Composio API key for Tool Router
COMPOSIO_API_KEY=your-composio-api-key

# OpenAI Embedding Key (for memory semantic search - optional)
# Memory search works without this (uses text fallback)
OPENAI_EMBEDDING_KEY=your-openai-embedding-key

# ========================================
# Server
# ========================================
PORT=3001