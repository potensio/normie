# OpenClaude Cowork Environment Configuration

# ========================================
# Database (Neon PostgreSQL)
# ========================================
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ========================================
# Auth Secrets
# ========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-key
ENCRYPTION_KEY=your-32-byte-encryption-key

# ========================================
# AI Providers
# ========================================
# Anthropic API key for Claude Agent SDK
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI Embedding Key (for memory semantic search - optional)
# Memory search works without this (uses text fallback)
OPENAI_EMBEDDING_KEY=your-openai-embedding-key

# ========================================
# Optional Provider Keys
# ========================================
# Kimi API key
KIMI_API_KEY=your-kimi-api-key

# AWS Bedrock API key (via Mantle)
BEDROCK_API_KEY=your-bedrock-api-key

# Composio API key for Tool Router
COMPOSIO_API_KEY=your-composio-api-key

# ========================================
# Server
# ========================================
PORT=3001